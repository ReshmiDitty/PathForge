# ==============================================================
# PathForge – Career Compass & Venture Studio
# Environment Configuration Template
# ==============================================================
# Copy this file to .env and fill in your values.
# The application automatically falls back to intelligent rule-based
# engines and demo checkout mode if external keys are not provided.

# Flask Application Secret Key for session signing
SECRET_KEY=pathforge_secret_dev_key_change_in_production_2026

# Database Configuration (SQLite default)
DATABASE_URL=sqlite:///pathforge.db

# Anthropic Claude API (Optional - rule-based fallback works seamlessly if omitted)
# Get a key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Razorpay Test Mode Credentials (Optional - built-in demo checkout works if omitted)
# Get test keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Server Configuration
FLASK_APP=app.py
FLASK_DEBUG=True
PORT=5000

